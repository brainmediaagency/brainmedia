{
  "name": "brain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "node -e \"console.log('\\nFirestore rules tests require the emulator.\\n  Run: npm run test:rules:emu\\n');\"",
    "test:rules:run": "vitest run --config vitest.rules.config.ts",
    "test:rules:emu": "firebase emulators:exec --only firestore \"npm run test:rules:run\"",
    "admin:set-role": "tsx scripts/admin/set-user-role.ts",
    "admin:create-user": "tsx scripts/admin/create-user-profile.ts",
    "admin:sync-onesignal": "tsx scripts/admin/sync-onesignal-users.ts",
    "admin:sync-claims": "tsx scripts/admin/sync-claims-from-profiles.ts",
    "admin:delete-user": "tsx scripts/admin/delete-user.ts",
    "admin:refresh-storage": "tsx scripts/admin/refresh-storage-usage.ts",
    "seed:emulator": "tsx scripts/admin/seed-emulator.ts",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hookform/resolvers": "^5.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
