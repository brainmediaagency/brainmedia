VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-site-key

# OneSignal Web Push (App ID only — REST key lives in Apps Script)
# See scripts/onesignal/README.md
# VITE_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Local development only — never set in production builds
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=your-debug-token

# Optional: Google Sheets log + OneSignal pushNotify via Apps Script Web App
# (see scripts/sheets-webhook/README.md and scripts/onesignal/README.md)
# Vite embeds these at build time — rebuild hosting after changing.
# Auth is Firebase ID token (currentUser.getIdToken) — never ship a webhook secret.
# Apps Script Script Property FIREBASE_WEB_API_KEY = same as VITE_FIREBASE_API_KEY.
# VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Coordinator/management Excel tab — embedded Google Sheets (view/edit in iframe).
# Unrelated to the Apps Script webhook above. Share the sheet with coordinator
# Google accounts as Editor. Prefer ID; or set a full embed URL.
# VITE_GOOGLE_SHEETS_ID=your-spreadsheet-id
# VITE_GOOGLE_SHEETS_EMBED_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit?usp=sharing&rm=minimal

# Admin scripts (Node) — path to service account JSON outside the repo preferred
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
